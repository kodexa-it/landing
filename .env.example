# Copiar a .env.local y completar. Nunca commitear secretos.

# URL pública de esta landing (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://ecosistema.kodexa.ar

# URL pública del sitio institucional original (botón "Conocé más sobre Kodexa").
NEXT_PUBLIC_INSTITUTIONAL_URL=https://kodexa.ar

# Formulario de contacto (Forminit). Sin la API key el formulario responde 503 y NO simula envíos.
FORMINIT_API_KEY=
# Opcional: por defecto usa el formulario ya en producción en kodexa.ar.
FORMINIT_FORM_ID=

# Analítica (opcionales; si faltan, no se carga nada). Cargar solo UNA vez por dominio.
# GTM del sitio original: GTM-PX8R7ZH8 (incluye GA4 G-BX1MFLCDJH). Clarity: yzr1ci43mv.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=

# "true" bloquea la indexación (robots noindex) mientras la landing esté en revisión.
NEXT_PUBLIC_SITE_PREVIEW=true

# Google Tag Manager (por defecto GTM-KQFJZWBN). Solo carga en producción.
NEXT_PUBLIC_GTM_ID=GTM-KQFJZWBN
# Poner en "true" para cargar el tracking también en desarrollo
NEXT_PUBLIC_TRACKING_DEV=false
